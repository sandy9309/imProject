# 1. 絕對不能上傳的依賴套件（超級巨嬰）
node_modules/
/jspm_packages/

# 2. 絕對不能上傳的環境變數與隱私密鑰（安全關鍵）
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem

# 3. 生產環境打包出來的成品檔案（由伺服器自動生成即可）
/build
/dist
/out

# 4. 編輯器或作業系統產生的垃圾暫存檔
.DS_Store
.vscode/
.idea/
npm-debug.log*
yarn-debug.log*
yarn-error.log*